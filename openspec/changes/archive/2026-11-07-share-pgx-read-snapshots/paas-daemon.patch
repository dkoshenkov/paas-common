new file mode 100644
--- /dev/null
+++ b/internal/store/snapshot_test.go
@@ -0,0 +1,22 @@
+package store
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/jackc/pgx/v5"
+)
+
+func TestSnapshotRollbackFailureIsUnavailable(t *testing.T) {
+	st := testDatabase(t).prepare(t)
+	result, err := readSnapshot(t.Context(), st, func(ctx context.Context, tx pgx.Tx) (int, error) {
+		return 1, tx.Conn().Close(ctx)
+	})
+	if result != 0 || !errors.Is(err, ErrUnavailable) {
+		t.Fatal("expected unavailable and zero result", result, err)
+	}
+	if err := st.Ready(t.Context()); err != nil {
+		t.Fatal("pool did not recover", err)
+	}
+}
